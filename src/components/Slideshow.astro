---
import fs from 'fs';
import path from 'path';
import { execSync } from 'child_process';

let slideshowFiles = [];
try {
  const manifestPath = path.join(process.cwd(), 'public', 'slideshow-manifest.json');
  if (fs.existsSync(manifestPath)) {
    slideshowFiles = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
  } else {
    const dir = path.join(process.cwd(), 'public', 'Slideshow');
    if (fs.existsSync(dir)) {
      slideshowFiles = fs.readdirSync(dir).filter((f) => /\.(jpe?g|png|webp|avif|gif)$/i.test(f)).sort();
    }
  }
} catch (err) {
  slideshowFiles = [];
}

// Try to detect GitHub repo (owner/repo) and default branch for runtime listing
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

let githubOwner = '';
let githubRepo = '';
let githubBranch = 'main';
try {
  const remoteUrl = execSync('git config --get remote.origin.url', { stdio: 'pipe' }).toString().trim();
  if (remoteUrl) {
    // git@github.com:owner/repo.git or https://github.com/owner/repo.git
    const sshMatch = remoteUrl.match(/github.com[:/](.+?)\/(.+?)(?:\.git)?$/i);
    if (sshMatch) {
      githubOwner = sshMatch[1];
      githubRepo = sshMatch[2];
    }
  }
  // detect default branch
  try {
    const remoteInfo = execSync('git remote show origin', { stdio: 'pipe' }).toString();
    const m = remoteInfo.match(/HEAD branch:\s*(\S+)/);
    if (m) githubBranch = m[1];
  } catch (e) {
    // ignore
  }
} catch (e) {
  // ignore if not a git repo in environment
}

---

<section class="slideshow-section relative overflow-hidden bg-slate-950 text-white" data-github-owner={githubOwner} data-github-repo={githubRepo} data-github-branch={githubBranch} data-base-path={basePath}>
  <div class="mx-auto max-w-7xl px-6 py-4 sm:py-6">
    <div class="rounded-[2rem] border border-white/10 bg-slate-900/80 p-4 shadow-2xl shadow-slate-950/40">
      <div class="relative overflow-hidden rounded-[1.75rem] aspect-video md:aspect-[20/9] w-full bg-slate-950">
        {slideshowFiles.length ? (
            <div>
            <div class="slideshow-slides">
              {slideshowFiles.map((file, index) => (
                <div class={`slideshow-slide absolute inset-0 transition-opacity duration-1000 ${index === 0 ? 'opacity-100 pointer-events-auto z-10' : 'opacity-0 pointer-events-none z-0'}`} data-image={file}>
                  <img
                    src={`${basePath}Slideshow/${encodeURIComponent(file)}`}
                    alt={`Slide ${index + 1}`}
                    class="h-full w-full object-contain will-change-opacity"
                    loading="eager"
                  />
                </div>
              ))}
            </div>
              <button type="button" class="slideshow-prev absolute left-4 top-1/2 z-20 -translate-y-1/2 rounded-full bg-slate-900/70 p-3 text-white transition hover:bg-slate-800 focus:outline-none" aria-label="Previous slide">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.707 15.707a1 1 0 0 1-1.414 0L6.586 11l4.707-4.707a1 1 0 0 1 1.414 1.414L9.414 11l3.293 3.293a1 1 0 0 1 0 1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <button type="button" class="slideshow-next absolute right-4 top-1/2 z-20 -translate-y-1/2 rounded-full bg-slate-900/70 p-3 text-white transition hover:bg-slate-800 focus:outline-none" aria-label="Next slide">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.293 4.293a1 1 0 0 1 1.414 0L13.414 9l-4.707 4.707a1 1 0 0 1-1.414-1.414L10.586 9 7.293 5.707a1 1 0 0 1 0-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="pointer-events-none absolute inset-x-0 bottom-5 flex justify-center gap-2">
              {slideshowFiles.map((_, index) => (
                <button type="button" class="slideshow-dot h-2.5 w-2.5 rounded-full bg-white/50 opacity-75 transition focus:outline-none" aria-label={`Show slide ${index + 1}`}></button>
              ))}
            </div>
          </div>
        ) : (
          <div class="flex h-[320px] items-center justify-center bg-slate-800 text-center text-sm text-slate-300 sm:h-[420px]">
            Place slideshow images in <code class="rounded bg-slate-950 px-2 py-1 text-xs text-slate-200">public/Slideshow</code> to show them here.
          </div>
        )}
      </div>
    </div>
  </div>

  <script is:inline>
    async function initSlideshow() {
      const container = document.querySelector('.slideshow-section');
      if (!container) return;

      const basePath = container.dataset.basePath || '';
      let slides = Array.from(container.querySelectorAll('.slideshow-slide'));
      let dots = Array.from(container.querySelectorAll('.slideshow-dot'));
      const prev = container.querySelector('.slideshow-prev');
      const next = container.querySelector('.slideshow-next');
      if (!slides.length || !dots.length) return;

      let current = 0;
      let timer = null;
      let hoverPauseEnabled = false;

      // Preload images to avoid flicker or delayed loads when switching slides
      const imgs = () => slides.map((s) => s.querySelector('img')).filter(Boolean);
      const preload = () => {
        imgs().forEach((img) => {
          if (!img.complete) {
            const p = new Image();
            p.src = img.src;
          }
        });
      };

      // Fetch the build-time manifest and rebuild slides/dots when it changes
      const refreshFiles = async () => {
        // Try build-time manifest first
        try {
          const res = await fetch(`${basePath}slideshow-manifest.json`);
          if (res.ok) {
            const files = await res.json();
            if (Array.isArray(files) && files.length) {
              await applyFiles(files);
              return;
            }
          }
        } catch (e) {
          // ignore manifest fetch failures
        }

        // Fallback: try GitHub Contents API if repo info is available
        try {
          const owner = container.dataset.githubOwner;
          const repo = container.dataset.githubRepo;
          const branch = container.dataset.githubBranch || 'main';
          if (!owner || !repo) return;

          const api = `https://api.github.com/repos/${owner}/${repo}/contents/public/Slideshow?ref=${encodeURIComponent(branch)}`;
          const r = await fetch(api);
          if (!r.ok) return;
          const json = await r.json();
          if (!Array.isArray(json)) return;
          const files = json.map((item) => item.name).filter((n) => /\.(jpe?g|png|webp|avif|gif)$/i.test(n)).sort();
          if (!files.length) return;
          await applyFiles(files);
        } catch (e) {
          // ignore
        }
      };

      // Helper to rebuild DOM from file list
      const applyFiles = async (files) => {
        const existing = slides.map((s) => s.getAttribute('data-image'));
        if (files.length === existing.length && files.every((f, i) => f === existing[i])) return;

        const slidesContainer = container.querySelector('.slideshow-slides');
        const dotsContainer = container.querySelector('.pointer-events-none');
        slidesContainer.innerHTML = '';
        dotsContainer.innerHTML = '';

        files.forEach((file, idx) => {
          const div = document.createElement('div');
          div.className = idx === 0 ? 'slideshow-slide absolute inset-0 transition-opacity duration-1000 opacity-100 pointer-events-auto z-10' : 'slideshow-slide absolute inset-0 transition-opacity duration-1000 opacity-0 pointer-events-none z-0';
          div.setAttribute('data-image', file);

          const img = document.createElement('img');
          img.src = `${basePath}Slideshow/${encodeURIComponent(file)}`;
          img.alt = `Slide ${idx + 1}`;
          img.className = 'h-full w-full object-contain will-change-opacity';
          img.loading = 'eager';
          div.appendChild(img);

          slidesContainer.appendChild(div);

          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'slideshow-dot h-2.5 w-2.5 rounded-full bg-white/50 opacity-75 transition focus:outline-none';
          dot.setAttribute('aria-label', `Show slide ${idx + 1}`);
          dotsContainer.appendChild(dot);
        });

        slides = Array.from(container.querySelectorAll('.slideshow-slide'));
        dots = Array.from(container.querySelectorAll('.slideshow-dot'));

        dots.forEach((dot, index) => {
          if (dot._clickHandler) dot.removeEventListener('click', dot._clickHandler);
          const handler = () => {
            setActive(index);
            start();
          };
          dot._clickHandler = handler;
          dot.addEventListener('click', handler);
        });

        setActive(0);
        preload();
      };

      const setActive = (index) => {
        const safeIndex = (index + slides.length) % slides.length;

        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === safeIndex;
          slide.classList.toggle('opacity-100', isActive);
          slide.classList.toggle('opacity-0', !isActive);
          slide.classList.toggle('pointer-events-auto', isActive);
          slide.classList.toggle('pointer-events-none', !isActive);
          slide.classList.toggle('z-10', isActive);
          slide.classList.toggle('z-0', !isActive);
        });

        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === safeIndex;
          dot.classList.toggle('opacity-100', isActive);
          dot.classList.toggle('opacity-75', !isActive);
        });

        current = safeIndex;
      };

      const stop = () => {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      };

      const start = () => {
        stop();
        timer = window.setInterval(() => {
          setActive(current + 1);
          hoverPauseEnabled = true;
        }, 5000);
      };

      dots.forEach((dot, index) => {
        if (dot._clickHandler) dot.removeEventListener('click', dot._clickHandler);
        const handler = () => {
          setActive(index);
          start();
        };
        dot._clickHandler = handler;
        dot.addEventListener('click', handler);
      });

      prev?.addEventListener('click', () => {
        setActive(current - 1);
        start();
      });

      next?.addEventListener('click', () => {
        setActive(current + 1);
        start();
      });

      container.addEventListener('mouseenter', () => {
        if (!hoverPauseEnabled) return;
        stop();
      });
      container.addEventListener('mouseleave', () => {
        if (!hoverPauseEnabled) return;
        start();
      });

      setActive(0);
      preload();
      start();

      // Poll for new images (dev-friendly). If your deployment supports
      // server endpoints, new images will be appended at runtime.
      setInterval(() => refreshFiles(), 5000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initSlideshow(), { once: true });
    } else {
      initSlideshow();
    }
  </script>
</section>
