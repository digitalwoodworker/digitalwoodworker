---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FAQ | DigitalWoodworker</title>
    <meta name="description" content="Frequently asked questions about DigitalWoodworker commissions and services." />
    <script data-goatcounter="https://digitalwoodworker.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="mb-12 text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">FAQ</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Frequently asked questions</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">
          Answers to common questions about our process, materials, and commissioning custom woodcraft.
        </p>
      </section>

      <section class="space-y-4">
        {[
          {
            question: 'How long does a custom piece take to complete?',
            answer: 'Most custom projects take between 3 and 6 weeks depending on complexity, material availability, and finishing requirements.',
          },
          {
            question: 'Can I request a specific type of wood for my commission?',
            answer: 'Yes. We work with a variety of hardwoods and can recommend the best species based on your design and desired finish.',
          },
          {
            question: 'Do you offer international shipping?',
            answer: 'Yes, international shipping is available. Shipping costs and delivery time depend on the destination and order size.',
          },
        ].map((item, index) => (
          <details class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-6 shadow-sm" key={index}>
            <summary class="cursor-pointer text-lg font-semibold text-slate-950 list-none marker:hidden">
              {item.question}
            </summary>
            <p class="mt-4 text-base leading-7 text-slate-600">{item.answer}</p>
          </details>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>
