---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Slideshow from '../components/Slideshow.astro';
import Hero from '../components/Hero.astro';
//import ProcessCards from '../components/ProcessCards.astro';
import AboutSection from '../components/AboutSection.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import SEO from '../components/SEO.astro';
//import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

---

<html lang="en">
  <head>
    <SEO
      title="DigitalWoodworker | Bespoke Woodcrafts in India"
      description="Custom woodworking studio in India crafting high-end scale models, chess sets, intarsia, clocks, and fine wooden accessories. Hand-finished with uncompromised precision."
      keywords="custom woodworking, custom wood work in Kerala, custom wood work in Trivandrum, custom woodwork Kerala, custom woodwork Trivandrum, handcrafted woodwork, wood artisan Kerala, bespoke woodwork Trivandrum, scale models, chess sets, intarsia, bespoke clocks, wood artisan, woodart"
      image="/Chess-Set/Chessset.jpg"
    />
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main>
      <Slideshow />
      <Hero />
      <!-- <ProcessCards /> -->
      <AboutSection />
      <PortfolioGrid />
      <!-- <ContactSection /> -->
    </main>
    <Footer />
  </body>
</html>

