---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const publicDir = fileURLToPath(new URL('../../public', import.meta.url));
const basePath = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL;
const cardFolders = {
  'scale-models': 'Scale-Models',
  'wood-turning': 'Wood-Turning',
  boxes: 'Boxes',
  'chess-set': 'Chess-Set',
  intarsia: 'Intarsia',
  clocks: 'Clocks',
};

function randomCardImage(folder) {
  const folderPath = path.join(publicDir, folder);
  if (!fs.existsSync(folderPath)) return null;
  const files = fs.readdirSync(folderPath).filter((file) => /\.(jpe?g|png|webp|gif|svg)$/i.test(file));
  if (!files.length) return null;
  return `${basePath}${encodeURIComponent(folder)}/${encodeURIComponent(files[Math.floor(Math.random() * files.length)])}`;
}

const cards = [
  { href: '/scale-models', title: 'Scale Models', description: 'Browse precision woodworking for miniature builds, display models, and detailed replicas.' },
  { href: '/wood-turning', title: 'Wood Turning', description: 'Discover turned wood vessels, bowls, and specialty pieces crafted with fine form and finish.' },
  { href: '/boxes', title: 'Boxes', description: 'Explore custom box designs for keepsakes, storage, and presentation with thoughtful joinery.' },
  { href: '/chess-set', title: 'Chess Set', description: 'View elegant game pieces and boards made from premium woods and refined detailing.' },
  { href: '/intarsia', title: 'Intarsia', description: 'See decorative inlay and wood art that combines color, texture, and pattern in striking designs.' },
  { href: '/clocks', title: 'Clocks', description: 'Discover timepieces that pair precise mechanics with handcrafted wood faces and finishes.' },
].map((card) => ({
  ...card,
  image: randomCardImage(cardFolders[card.href.slice(1)]),
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work & Commissions | DigitalWoodworker</title>
    <meta name="description" content="Work and commissions from DigitalWoodworker." />
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="mb-16 text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">Work & Commissions</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Crafted commissions and custom furniture work.</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">
          Explore our current project categories with placeholder pages for each service. Replace this copy when the studio content is ready.
        </p>
      </section>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {cards.map((card) => (
          <a href={card.href} class="group overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-50 transition hover:border-slate-300 hover:bg-white">
            {card.image ? (
              <div class="flex items-center justify-center bg-slate-100 overflow-hidden max-h-56 md:max-h-72 lg:max-h-80">
                <img
                  class="w-full h-auto object-center transition duration-300 group-hover:scale-[1.02]"
                  src={card.image}
                  alt={`${card.title} preview`}
                />
              </div>
            ) : null}
            <div class="p-8 text-center">
              <h2 class="text-xl font-semibold text-slate-950">{card.title}</h2>
              <p class="mt-3 text-sm leading-7 text-slate-600">{card.description}</p>
            </div>
          </a>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
