---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FAQ | DigitalWoodworker</title>
    <link
      rel="icon"
      type="image/x-icon"
      href={import.meta.env.BASE_URL + "favicon.ico"}
    />
    <link
      rel="shortcut icon"
      type="image/x-icon"
      href={import.meta.env.BASE_URL + "favicon.ico"}
    />
    <meta
      name="description"
      content="Frequently asked questions about DigitalWoodworker commissions and services."
    />
    <script
      data-goatcounter="https://digitalwoodworker.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="mb-12 text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">FAQ</p>
        <h1
          class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl"
        >
          Frequently asked questions
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">
          Answers to common questions about my process, materials, and
          commissioning custom woodcraft.
        </p>
      </section>

      <section class="space-y-4">
        {
          [
            {
              question: "How do I place an order?",
              answer:
                "Since most of my work is bespoke, the best way to order is to send me a message through the contact form or directly via Instagram DM. Share your idea, rough dimensions, or design inspiration, and we’ll discuss how to bring it to life.",
            },
            {
              question: "How long does a custom piece take to complete?",
              answer:
                "Most custom projects take between 3 and 6 weeks depending on complexity, material availability, and finishing requirements.",
            },
            {
              question: "Is everything shown on the website for sale?",
              answer:
                "Not always. Many pieces on the site are past custom commissions, limited-run builds, or scale models made as one-off technical challenges. However, if a piece catches your eye, I can often build a similar custom version tailored to your specifications.",
            },
            
            {
              question: "Why aren't prices listed on the site?",
              answer:
                "Because almost every project is custom-engineered! Prices vary based on wood species, level of detail, scale, hardware, and specialized machinery required. Once we discuss your project details, I provide a detailed, itemized quote.",
            },
            {
              question: "I have a project that isn't shown anywhere on your site. Will you be interested?",
              answer:
                "Absolutely. In fact, unique and unusual builds are my favorite. I thrive on solving complex engineering and woodworking challenges, so if you have a non-standard concept—no matter how technical or unusual—reach out!",
            },
            {
              question:
                "Can I request a specific type of wood for my commission?",
              answer:
                "Yes. I work with a variety of hardwoods and can recommend the best species based on your design and desired finish.",
            },
            {
              question: "Do you offer international shipping?",
              answer:
                "No, international shipping is not currently offered. I only ship within India.",
            },
          ].map((item, index) => (
            <details
              class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-6 shadow-sm"
              key={index}
            >
              <summary class="cursor-pointer text-lg font-semibold text-slate-950 list-none marker:hidden">
                {item.question}
              </summary>
              <p class="mt-4 text-base leading-7 text-slate-600">
                {item.answer}
              </p>
            </details>
          ))
        }
      </section>
    </main>
    <Footer />
  </body>
</html>
