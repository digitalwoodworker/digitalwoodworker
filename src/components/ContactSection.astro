---
---

<section id="contact" class="bg-slate-950 py-20 text-slate-100">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-12 lg:grid-cols-[0.95fr_0.95fr] lg:items-start">
      <div>
        <p class="text-sm uppercase tracking-[0.4em] text-amber-400">Contact</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Ready to start your commission?</h2>
        <p class="mt-6 max-w-xl text-sm leading-7 text-slate-300">
          Share a few details below and we’ll follow up with a custom consultation. If you already have drawings or reference images, include them in the message.
        </p>
        <div class="mt-8 space-y-4 rounded-[1.75rem] border border-slate-800 bg-slate-900/80 p-6 text-sm text-slate-400 shadow-xl shadow-slate-950/40">
          <p><strong class="text-white">Email:</strong> hello@digitalwoodworker.com</p>
          <p><strong class="text-white">Phone:</strong> (555) 123-4567</p>
          <p><strong class="text-white">Hours:</strong> Mon–Fri · 9:00–17:00</p>
        </div>
      </div>

      <form class="space-y-5 rounded-[2rem] border border-slate-800 bg-slate-900/95 p-8 shadow-2xl shadow-slate-950/50" method="POST" action="#">
        <div>
          <label class="mb-3 block text-sm font-semibold text-slate-200" for="name">Name</label>
          <input id="name" name="name" type="text" required class="w-full rounded-3xl border border-slate-800 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none ring-1 ring-transparent transition focus:ring-amber-400" />
        </div>
        <div>
          <label class="mb-3 block text-sm font-semibold text-slate-200" for="email">Email</label>
          <input id="email" name="email" type="email" required class="w-full rounded-3xl border border-slate-800 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none ring-1 ring-transparent transition focus:ring-amber-400" />
        </div>
        <div>
          <label class="mb-3 block text-sm font-semibold text-slate-200" for="project">Project details</label>
          <textarea id="project" name="project" rows="5" required class="w-full rounded-3xl border border-slate-800 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none ring-1 ring-transparent transition focus:ring-amber-400"></textarea>
        </div>
        <button type="submit" class="inline-flex w-full items-center justify-center rounded-full bg-amber-300 px-6 py-3 text-sm font-semibold uppercase tracking-[0.16em] text-slate-950 transition hover:bg-amber-200">
          Send inquiry
        </button>
        <p class="text-xs leading-5 text-slate-500">We will reply within 1–2 business days. Your information is never shared.</p>
      </form>
    </div>
  </div>
</section>
