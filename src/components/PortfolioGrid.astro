---
const projects = [
  { title: 'Live-Edge Oak Dining Table', subtitle: 'Solid walnut base with natural edge oak', image: 'https://images.unsplash.com/photo-1493666438817-866a91353ca9?auto=format&fit=crop&w=900&q=80' },
  { title: 'Charcuterie Board Set', subtitle: 'Hand-rubbed walnut with brass handles', image: 'https://images.unsplash.com/photo-1517325065758-5fb062a8d8a6?auto=format&fit=crop&w=900&q=80' },
  { title: 'Walnut Entryway Bench', subtitle: 'Minimal profile with hidden storage', image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=900&q=80' },
];
---

<section id="portfolio" class="py-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.4em] text-amber-500">Featured portfolio highlights</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Beautiful pieces made to order.</h2>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {projects.map((project) => (
        <article class="group overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-950 shadow-lg shadow-slate-900/10">
          <div class="aspect-[4/3] bg-cover bg-center transition duration-500 group-hover:scale-105" style={`background-image:url(${project.image})`}></div>
          <div class="space-y-2 p-6">
            <h3 class="text-lg font-semibold text-white">{project.title}</h3>
            <p class="text-sm leading-7 text-slate-300">{project.subtitle}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
