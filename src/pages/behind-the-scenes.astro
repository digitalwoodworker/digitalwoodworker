---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const basePath = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL;

const assetPath = (folder: string, file: string) => `${basePath}BTS/${encodeURIComponent(folder)}/${encodeURIComponent(file)}`;

const btsSections = [
  {
    title: 'Work In Progress',
    intro: 'Snapshots from pieces still taking shape, showing the build as it evolves from raw material to finished form.',
    items: [
      {
        image: assetPath('WIP', 'Teak.png'),
        alt: 'Work in progress piece in teak',
        description: 'An in-progress teak build showing material preparation and early shaping before the final finish is applied.',
      },
    ],
  },
  {
    title: 'Tools',
    intro: 'The tools, fixtures, and reference materials that help deliver clean cuts, accurate shaping, and reliable repeatability.',
    items: [
      {
        image: assetPath('Tools', 'Screenshot_17-6-2026_101133_in.pinterest.com.jpeg'),
        alt: 'Reference and tool setup',
        description: 'A look at one of the tools or references used during planning and making, highlighting the precision behind the process.',
      },
    ],
  },
  {
    title: 'Smaller Yet Significant Things',
    intro: 'The small details that often go unnoticed, but play a major role in the quality, finish, and personality of a piece.',
    items: [
      {
        image: assetPath('Details', 'Precision Dog Intarsia Pattern _ Woodworking Template PDF.jpg'),
        alt: 'Small but significant design detail',
        description: 'A close-up detail that reflects the careful decisions and fine touches that elevate the final work.',
      },
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Behind the Scenes | DigitalWoodworker</title>
    <meta name="description" content="Get a behind-the-scenes look at the craftsmanship and workshop process." />
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="mb-12 text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">Behind the scenes</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">A closer look at our process.</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">
          See how ideas become custom pieces with careful planning, precision work, and thoughtful finishing.
        </p>
      </section>

      <section class="space-y-16">
        {btsSections.map((section) => (
          <div class="space-y-6">
            <div>
              <h2 class="text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">{section.title}</h2>
              <p class="mt-3 max-w-3xl text-base leading-8 text-slate-600">{section.intro}</p>
            </div>

            <div class="grid gap-8 sm:grid-cols-2 xl:grid-cols-3">
              {section.items.map((item) => (
                <article class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-50 shadow-sm shadow-slate-900/5">
                  <a href={item.image} target="_blank" rel="noreferrer" class="block overflow-hidden rounded-t-[1.75rem] bg-slate-200">
                    <img
                      src={item.image}
                      alt={item.alt}
                      class="h-72 w-full object-contain bg-slate-100"
                      loading="lazy"
                    />
                  </a>
                  <div class="p-6">
                    <p class="text-sm leading-7 text-slate-600">{item.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>
