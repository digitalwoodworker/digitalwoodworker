---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = new URL('/about-the-craft/', Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- SEO META START -->
    <title>About the Craft | DigitalWoodworker</title>
    <meta name="description" content="Learn about the woodworking craft, materials, finishes, and techniques behind DigitalWoodworker’s handcrafted custom pieces." />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="woodworking craft, custom wood finishes, timber selection, artisan techniques, handmade furniture" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="About the Craft | DigitalWoodworker" />
    <meta property="og:description" content="Learn about the woodworking craft, materials, finishes, and techniques behind DigitalWoodworker’s handcrafted custom pieces." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="DigitalWoodworker" />
    <meta property="og:image" content={import.meta.env.BASE_URL + 'dw_logo.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="About the Craft | DigitalWoodworker" />
    <meta name="twitter:description" content="Learn about the woodworking craft, materials, finishes, and techniques behind DigitalWoodworker’s handcrafted custom pieces." />
    <meta name="twitter:image" content={import.meta.env.BASE_URL + 'dw_logo.png'} />
    <!-- SEO META END -->
    <link rel="icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <link rel="shortcut icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <script data-goatcounter="https://digitalwoodworker.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="mb-16 text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">About the Craft</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">The craft behind our custom work.</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">
          Learn more about the materials, finishes, and techniques that make each piece unique. Placeholder sections are ready for your content.
        </p>
      </section>

      <div class="grid gap-8 md:grid-cols-3">
        <a href="#materials" class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-8 text-center transition hover:border-slate-300 hover:bg-white">
          <h2 class="text-xl font-semibold text-slate-950">Materials</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">Placeholder for material sourcing and wood selection details.</p>
        </a>
        <a href="#finishes" class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-8 text-center transition hover:border-slate-300 hover:bg-white">
          <h2 class="text-xl font-semibold text-slate-950">Finishes</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">Placeholder for finishes, oils, and maintenance guidance.</p>
        </a>
        <a href="#techniques" class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-8 text-center transition hover:border-slate-300 hover:bg-white">
          <h2 class="text-xl font-semibold text-slate-950">Techniques</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">Placeholder for joinery, craftsmanship, and workshop methods.</p>
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>
