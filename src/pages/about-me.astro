---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Me | DigitalWoodworker</title>
    <link rel="icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <link rel="shortcut icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <meta name="description" content="Learn about the creator behind DigitalWoodworker." />
    <script data-goatcounter="https://digitalwoodworker.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="mb-12 text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">About Me</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Meet the craftsman behind every piece.</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">
          Driven by patience, uncompromised tools, and a relentless commitment to fine woodcraft.
        </p>
      </section>

      <section class="space-y-8">
        <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-10 shadow-sm">
          <h2 class="text-2xl font-semibold text-slate-950">A Passion Carved in Wood</h2>
          <p class="mt-4 text-base leading-8 text-slate-600">
            Hi There, I'm Nithin the face behind DigitalWoodworker.
          </p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
