---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Slideshow from '../components/Slideshow.astro';
import Hero from '../components/Hero.astro';
//import ProcessCards from '../components/ProcessCards.astro';
import AboutSection from '../components/AboutSection.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
//import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DigitalWoodworker</title>
    <meta name="description" content="Bespoke woodworking studio creating custom tables, benches, and boards." />
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main>
      <Slideshow />
      <Hero />
      <!-- <ProcessCards /> -->
      <AboutSection />
      <PortfolioGrid />
      <!-- <ContactSection /> -->
    </main>
    <Footer />
  </body>
</html>
