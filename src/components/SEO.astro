---
interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  keywords,
  image = '/dw_logo.png',
  canonicalPath = Astro.url.pathname,
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const imageUrl = new URL(image, Astro.site).toString();
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{keywords ? <meta name="keywords" content={keywords} /> : null}
<link rel="canonical" href={canonicalUrl} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="DigitalWoodworker" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<link rel="icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
<link rel="shortcut icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
<script data-goatcounter="https://digitalwoodworker.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
