---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProcessCards from '../components/ProcessCards.astro';

const title = 'Custom Pieces';
const copy = 'Explore bespoke custom projects designed from scratch, blending precision craftsmanship with your personal style and functional needs.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | DigitalWoodworker</title>
    <link rel="icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <link rel="shortcut icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <meta name="description" content={copy} />
    <script data-goatcounter="https://digitalwoodworker.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="bg-white text-slate-900">
    <Header />
        <ProcessCards />
    <Footer />
  </body>
</html>  
