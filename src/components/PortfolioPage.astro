---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PortfolioGallery from './PortfolioGallery.astro';

const { title, subtitle, copy, folderName } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | DigitalWoodworker</title>
    <meta name="description" content={copy} />
  </head>
  <body class="portfolio-background bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="text-center">
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">{title}</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-white/80">{copy}</p>
      </section>

      <PortfolioGallery folderName={folderName} />
    </main>
    <Footer />
  </body>
</html>
