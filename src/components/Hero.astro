---
const basePath = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? basePath : `${basePath}${href.slice(1)}`);
---

<section class="relative overflow-hidden bg-slate-950 text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(251,191,36,0.22),_transparent_30%)]"></div>
  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,23,42,0.8)_0%,rgba(15,23,42,0.9)_100%)]"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-20 md:py-28">
    <div class="grid gap-16 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div class="max-w-2xl">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-300">Bespoke Woodcrafts</p>
        <h1 class="mt-6 text-5xl font-semibold tracking-tight text-white sm:text-6xl">
          Handcrafted wooden art and intricate designs for distinctive spaces.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-slate-300">
          Bring your vision to life through one-of-a-kind bespoke creations shaped from exquisite hardwoods with meticulous craftsmanship.
        </p>

        <div class="mt-10 flex">
          <a class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/10 px-7 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-white/20" href={withBase('/work-and-commissions')}>
            View portfolio
          </a>
        </div>
      </div>

      <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-2xl shadow-slate-950/40 md:p-8">
        <div class="aspect-[4/3] w-full overflow-hidden rounded-[1.75rem] bg-slate-800">
          <div class="h-full bg-[url('/Chess-Set/Chessset.jpg')] bg-cover bg-center"></div>
        </div>
      </div>
    </div>
  </div>
</section>
