---
const steps = [
  { number: '1', title: 'Consult & Design', description: 'Client sketch, discussion' },
  { number: '2', title: 'Material Selection', description: 'Wood species samples' },
  { number: '3', title: 'Crafting & Updates', description: 'Saw, planer, workshop progress' },
  { number: '4', title: 'Delivery & Finish', description: 'Finished table, smiling client' },
];
---

<section id="process" class="bg-slate-100 py-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.4em] text-amber-500">The custom order process</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Built around clarity and confidence.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-slate-600">
        Every commission follows a simple, client-focused workflow so you know exactly what to expect from sketch to delivery.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {steps.map((step) => (
        <article class="rounded-[2rem] border border-slate-200 bg-white p-8 text-center shadow-sm shadow-slate-900/5">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-100 text-2xl font-semibold text-amber-700">
            {step.number}
          </div>
          <h3 class="mt-6 text-lg font-semibold text-slate-950">{step.title}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
