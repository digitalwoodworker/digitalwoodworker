---
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const { folderName } = Astro.props;
const publicDir = fileURLToPath(new URL('../../public', import.meta.url));
const galleryPath = path.join(publicDir, folderName);
const imageFiles = fs.existsSync(galleryPath)
  ? fs.readdirSync(galleryPath).filter((file) => /\.(jpe?g|png|webp|gif|svg)$/i.test(file))
  : [];
const galleryImages = imageFiles.sort();
---

<section class="mt-12">
  <div class="mx-auto max-w-7xl">
    <div class="rounded-[2.5rem] border border-slate-200 bg-white/80 p-6 shadow-xl shadow-slate-900/5 backdrop-blur-sm md:p-8">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-950">Portfolio showcase</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">Each gallery pulls image files directly from the page’s public folder so new work appears automatically as you add photos.</p>
    </div>

    {galleryImages.length > 0 ? (
      <div class="mt-10 columns-1 sm:columns-2 xl:columns-3 [column-gap:1.5rem]">
        {galleryImages.map((image) => (
          <article class="inline-block w-full break-inside-avoid overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-lg shadow-slate-900/10 mb-6">
            <a href={`/${encodeURIComponent(folderName)}/${encodeURIComponent(image)}`} target="_blank" rel="noreferrer" class="block cursor-pointer">
              <img
                class="w-full h-auto bg-slate-100 transition duration-300 hover:scale-[1.01]"
                src={`/${encodeURIComponent(folderName)}/${encodeURIComponent(image)}`}
                alt={image.replace(/[-_]/g, ' ').replace(/\.[^.]+$/, '')}
              />
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-10 rounded-[2rem] border border-slate-200 bg-slate-50 p-12 text-center">
        <p class="text-base text-slate-600">No portfolio images were found for <strong>{folderName}</strong>. Add photos to <code class="rounded bg-slate-100 px-2 py-1 text-sm text-slate-700">public/{folderName}</code> to populate this gallery.</p>
      </div>
    )}
  </div>
</section>
