---
import fs from 'fs';
import path from 'path';
import { execSync } from 'child_process';

const { folderName } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const encodePathSegments = (value: string) => value.split('/').map((segment) => encodeURIComponent(segment)).join('/');
const folderPath = encodePathSegments(folderName);
const imageUrl = (image: string) => `${basePath}${folderPath}/${encodeURIComponent(image)}`;
const publicDir = path.join(process.cwd(), 'public');
const galleryPath = path.join(publicDir, folderName);
const imageFiles = fs.existsSync(galleryPath)
  ? fs.readdirSync(galleryPath).filter((file) => /\.(jpe?g|png|webp|gif|svg)$/i.test(file))
  : [];
const galleryImages = imageFiles.sort();
const workDefinitions = [
  ['Scale Models', 'scale-models', 'Scale-Models'],
  ['Wood Turning', 'wood-turning', 'Wood-Turning'],
  ['Boxes', 'boxes', 'Boxes'],
  ['Chess Set', 'chess-set', 'Chess-Set'],
  ['Intarsia', 'intarsia', 'Intarsia'],
  ['Clocks', 'clocks', 'Clocks'],
  ['Name Boards', 'name-boards', 'Name-Boards'],
  ['Home Improvement', 'home-improvement', 'Home-Improvement'],
  ['Miniatures', 'miniatures', 'Miniatures'],
  ['Keychains', 'keychains', 'Keychains'],
  ['Jewelry', 'jewelry', 'Jewelry'],
  ['Many More', 'many-more', 'Many-More'],
];
const recommendationWorks = workDefinitions
  .map(([title, slug, folder]) => {
    const folderPath = path.join(publicDir, folder);
    const files = fs.existsSync(folderPath)
      ? fs.readdirSync(folderPath).filter((file) => /\.(jpe?g|png|webp|gif|svg)$/i.test(file))
      : [];
    if (!files.length) return null;
    const image = files[Math.floor(Math.random() * files.length)];
    return {
      title,
      slug,
      image: `${basePath}${encodePathSegments(folder)}/${encodeURIComponent(image)}`,
    };
  })
  .filter(Boolean);

let githubOwner = 'digitalwoodworker';
let githubRepo = 'digitalwoodworker';
let githubBranch = 'master';
try {
  const remoteUrl = execSync('git config --get remote.origin.url', { stdio: 'pipe' }).toString().trim();
  const sshMatch = remoteUrl.match(/github.com[:/](.+?)\/(.+?)(?:\.git)?$/i);
  if (sshMatch) {
    githubOwner = sshMatch[1];
    githubRepo = sshMatch[2];
  }
} catch (e) {
  // ignore
}
---

<section
  class="mt-12"
  data-portfolio-gallery
  data-folder-name={folderName}
  data-base-path={basePath}
  data-github-owner={githubOwner}
  data-github-repo={githubRepo}
  data-github-branch={githubBranch}
  data-recommendation-works={JSON.stringify(recommendationWorks)}
>
  <div class="mx-auto max-w-7xl">
    
    {galleryImages.length > 0 ? (
      <div class="portfolio-gallery-grid mt-10">
        {galleryImages.map((image) => (
          <article class="mb-6 inline-block w-full break-inside-avoid overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-lg shadow-slate-900/10">
            <a href={imageUrl(image)} data-gallery-image data-gallery-index={galleryImages.indexOf(image)} class="block cursor-pointer">
              <img
                class="w-full h-auto bg-slate-100 transition duration-300 hover:scale-[1.01]"
                src={imageUrl(image)}
                alt={image.replace(/[-_]/g, ' ').replace(/\.[^.]+$/, '')}
              />
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="portfolio-gallery-empty mt-10 rounded-[2rem] border border-slate-200 bg-slate-50 p-12 text-center">
        <p class="text-base text-slate-600">No portfolio images were found for <strong>{folderName}</strong>. Add photos to <code class="rounded bg-slate-100 px-2 py-1 text-sm text-slate-700">public/{folderName}</code> to populate this gallery.</p>
      </div>
    )}
  </div>

  <div class="portfolio-lightbox" data-portfolio-lightbox hidden>
    <div class="portfolio-lightbox-backdrop" data-lightbox-close></div>
    <div class="portfolio-lightbox-panel" role="dialog" aria-modal="true" aria-label={`${folderName} image viewer`}>
      <div class="portfolio-lightbox-toolbar">
        <span class="portfolio-lightbox-count" data-lightbox-count aria-live="polite"></span>
        <button type="button" class="portfolio-lightbox-button" data-lightbox-close aria-label="Close image viewer" title="Close image viewer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="portfolio-lightbox-stage">
        <button type="button" class="portfolio-lightbox-button portfolio-lightbox-nav" data-lightbox-previous aria-label="Show previous image" title="Previous image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <img class="portfolio-lightbox-image" data-lightbox-image alt="" />
        <button type="button" class="portfolio-lightbox-button portfolio-lightbox-nav" data-lightbox-next aria-label="Show next image" title="Next image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
        </button>
      </div>
      <div class="portfolio-lightbox-tools" role="group" aria-label="Image zoom controls">
        <button type="button" class="portfolio-lightbox-button" data-lightbox-zoom-out aria-label="Zoom out" title="Zoom out">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.8 4.5a6.3 6.3 0 1 0 0 12.6 6.3 6.3 0 0 0 0-12.6ZM15.4 15.4 20 20M8.2 10.8h5.2" /></svg>
        </button>
        <button type="button" class="portfolio-lightbox-button" data-lightbox-fit aria-label="Fit image to screen" title="Fit image to screen">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3M9 9h6v6H9z" /></svg>
        </button>
        <button type="button" class="portfolio-lightbox-button" data-lightbox-zoom-in aria-label="Zoom in" title="Zoom in">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.8 4.5a6.3 6.3 0 1 0 0 12.6 6.3 6.3 0 0 0 0-12.6ZM15.4 15.4 20 20M8.2 10.8h5.2M10.8 8.2v5.2" /></svg>
        </button>
      </div>
      <div class="portfolio-lightbox-end" data-lightbox-end hidden>
        <p class="portfolio-lightbox-end-title">That&apos;s all for now in {folderName}.</p>
        <p class="portfolio-lightbox-end-copy">Check out my other works.</p>
        <div class="portfolio-lightbox-recommendations" data-lightbox-recommendations></div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const root = document.currentScript?.parentElement;
      if (!root || !root.hasAttribute('data-portfolio-gallery')) return;

      const folderName = root.dataset.folderName || '';
      const basePath = root.dataset.basePath || '/';
      const encodePathSegments = (value) => value.split('/').map((segment) => encodeURIComponent(segment)).join('/');
      const folderPath = encodePathSegments(folderName);
      const imageUrl = (image) => `${basePath}${folderPath}/${encodeURIComponent(image)}`;
      const owner = root.dataset.githubOwner || 'digitalwoodworker';
      const repo = root.dataset.githubRepo || 'digitalwoodworker';
      const branch = root.dataset.githubBranch || 'master';
      const workSlug = folderName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      const grid = root.querySelector('.portfolio-gallery-grid');
      const emptyState = root.querySelector('.portfolio-gallery-empty');
      if (!folderName || !grid) return;

      const renderImages = (images) => {
        if (!images.length) return;
        if (emptyState) emptyState.remove();
        grid.innerHTML = '';
        images.forEach((image) => {
          const article = document.createElement('article');
          article.className = 'mb-6 inline-block w-full break-inside-avoid overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-lg shadow-slate-900/10';
          const anchor = document.createElement('a');
          anchor.href = imageUrl(image);
          anchor.dataset.galleryImage = '';
          anchor.dataset.galleryIndex = String(images.indexOf(image));
          anchor.className = 'block cursor-pointer';
          const img = document.createElement('img');
          img.className = 'w-full h-auto bg-slate-100 transition duration-300 hover:scale-[1.01]';
          img.src = imageUrl(image);
          img.alt = image.replace(/[-_]/g, ' ').replace(/\.[^.]+$/, '');
          img.loading = 'lazy';
          anchor.appendChild(img);
          article.appendChild(anchor);
          grid.appendChild(article);
        });
      };

      const lightbox = root.querySelector('[data-portfolio-lightbox]');
      const lightboxImage = root.querySelector('[data-lightbox-image]');
      const lightboxCount = root.querySelector('[data-lightbox-count]');
      const lightboxStage = root.querySelector('.portfolio-lightbox-stage');
      const previousButton = root.querySelector('[data-lightbox-previous]');
      const nextButton = root.querySelector('[data-lightbox-next]');
      const zoomOutButton = root.querySelector('[data-lightbox-zoom-out]');
      const fitButton = root.querySelector('[data-lightbox-fit]');
      const zoomInButton = root.querySelector('[data-lightbox-zoom-in]');
      const endPanel = root.querySelector('[data-lightbox-end]');
      const recommendations = root.querySelector('[data-lightbox-recommendations]');
      const closeButtons = root.querySelectorAll('[data-lightbox-close]');
      let activeImages = [];
      let activeIndex = 0;
      let previousOverflow = '';
      let centerEndState = false;
      let touchStartX = 0;
      let touchStartY = 0;
      let zoomScale = 1;
      let panX = 0;
      let panY = 0;
      let dragStartX = 0;
      let dragStartY = 0;
      let dragStartPanX = 0;
      let dragStartPanY = 0;
      let isDragging = false;

      const trackEvent = (name, title) => {
        if (typeof window.goatcounter?.count !== 'function') return;
        window.goatcounter.count({
          path: `gallery/${name}/${workSlug}`,
          title,
          event: true,
        });
      };
      let works = [];
      try {
        works = JSON.parse(root.dataset.recommendationWorks || '[]');
      } catch (e) {
        works = [];
      }

      const getVisitedWorks = () => {
        try {
          return JSON.parse(sessionStorage.getItem('digitalwoodworker-visited-works') || '[]');
        } catch (e) {
          return [];
        }
      };

      const markCurrentWorkVisited = () => {
        try {
          const visited = new Set(getVisitedWorks());
          visited.add(window.location.pathname.replace(/^\/+|\/+$/g, '').toLowerCase());
          sessionStorage.setItem('digitalwoodworker-visited-works', JSON.stringify([...visited]));
        } catch (e) {
          // Recommendations still work without session storage.
        }
      };

      const renderRecommendations = () => {
        if (!recommendations) return;
        const visited = new Set(getVisitedWorks());
        const otherWorks = works
          .filter(({ slug }) => !visited.has(slug))
          .sort(() => Math.random() - 0.5)
          .slice(0, window.matchMedia('(min-width: 768px)').matches ? 4 : 3);
        recommendations.innerHTML = '';
        otherWorks.forEach(({ title, slug, image }) => {
          const link = document.createElement('a');
          link.href = `${basePath}${slug}/`;
          link.className = 'portfolio-lightbox-recommendation';
          link.title = `View ${title}`;
          link.setAttribute('aria-label', `View ${title}`);
          link.addEventListener('click', () => {
            trackEvent('recommendation', `Opened recommended work ${title}`);
          });
          const imageElement = document.createElement('img');
          imageElement.src = image;
          imageElement.alt = title;
          imageElement.loading = 'lazy';
          link.appendChild(imageElement);
          const label = document.createElement('span');
          label.textContent = title;
          link.appendChild(label);
          recommendations.appendChild(link);
        });
      };

      const recommendationViewport = window.matchMedia('(min-width: 768px)');
      const refreshRecommendations = () => {
        if (endPanel && !endPanel.hidden) renderRecommendations();
      };
      if (recommendationViewport.addEventListener) {
        recommendationViewport.addEventListener('change', refreshRecommendations);
      } else {
        recommendationViewport.addListener(refreshRecommendations);
      }

      const applyImageTransform = () => {
        if (!lightboxImage || !lightboxStage) return;
        const maxPanX = Math.max(0, (lightboxImage.offsetWidth * zoomScale - lightboxStage.clientWidth) / 2);
        const maxPanY = Math.max(0, (lightboxImage.offsetHeight * zoomScale - lightboxStage.clientHeight) / 2);
        panX = Math.max(-maxPanX, Math.min(panX, maxPanX));
        panY = Math.max(-maxPanY, Math.min(panY, maxPanY));
        lightboxImage.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomScale})`;
        lightboxStage.classList.toggle('portfolio-lightbox-is-zoomed', zoomScale > 1);
      };

      const showImage = (index, showEndState = false) => {
        if (!lightbox || !lightboxImage || !activeImages.length) return;
        activeIndex = Math.max(0, Math.min(index, activeImages.length - 1));
        if (activeIndex !== activeImages.length - 1) centerEndState = false;
        const image = activeImages[activeIndex];
        zoomScale = 1;
        panX = 0;
        panY = 0;
        lightboxImage.src = image.src;
        lightboxImage.alt = image.alt;
        applyImageTransform();
        if (lightboxCount) lightboxCount.textContent = `${activeIndex + 1} / ${activeImages.length}`;
        if (previousButton) previousButton.hidden = activeImages.length < 2;
        if (nextButton) nextButton.hidden = activeImages.length < 2;
        if (endPanel) endPanel.hidden = true;
        lightbox.querySelector('.portfolio-lightbox-panel')?.classList.remove('portfolio-lightbox-centered');
        if (activeIndex === activeImages.length - 1 && showEndState) showEndOfGallery();
      };

      const showEndOfGallery = () => {
        if (!endPanel) return;
        if (nextButton) nextButton.hidden = true;
        if (centerEndState) lightbox.querySelector('.portfolio-lightbox-panel')?.classList.add('portfolio-lightbox-centered');
        renderRecommendations();
        endPanel.hidden = false;
      };

      const showPreviousImage = () => {
        trackEvent('previous', `Previous image in ${folderName}`);
        showImage(activeIndex - 1);
      };

      const showNextImage = () => {
        if (activeIndex < activeImages.length - 1) {
          trackEvent('next', `Next image in ${folderName}`);
          showImage(activeIndex + 1, false);
        } else {
          trackEvent('end', `Reached end of ${folderName}`);
          showEndOfGallery();
        }
      };

      const setZoom = (scale) => {
        zoomScale = Math.max(1, Math.min(scale, 4));
        if (zoomScale === 1) {
          panX = 0;
          panY = 0;
        }
        applyImageTransform();
      };

      const openLightbox = (index) => {
        if (!lightbox) return;
        activeImages = Array.from(root.querySelectorAll('[data-gallery-image]')).map((anchor) => ({
          src: anchor.href,
          alt: anchor.querySelector('img')?.alt || '',
        }));
        if (!activeImages.length) return;
        markCurrentWorkVisited();
        centerEndState = index === activeImages.length - 1;
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        lightbox.hidden = false;
        trackEvent('open', `Opened ${folderName} image ${index + 1}`);
        showImage(index, !centerEndState);
        closeButtons[1]?.focus();
      };

      const closeLightbox = () => {
        if (!lightbox) return;
        lightbox.hidden = true;
        document.body.style.overflow = previousOverflow;
        trackEvent('close', `Closed ${folderName} image viewer`);
      };

      grid.addEventListener('click', (event) => {
        const anchor = event.target.closest('[data-gallery-image]');
        if (!anchor) return;
        event.preventDefault();
        openLightbox(Number(anchor.dataset.galleryIndex) || 0);
      });

      closeButtons.forEach((button) => button.addEventListener('click', closeLightbox));
      previousButton?.addEventListener('click', showPreviousImage);
      nextButton?.addEventListener('click', showNextImage);
      zoomOutButton?.addEventListener('click', () => setZoom(zoomScale - 0.5));
      fitButton?.addEventListener('click', () => setZoom(1));
      zoomInButton?.addEventListener('click', () => setZoom(zoomScale + 0.5));
      lightboxStage?.addEventListener('pointerdown', (event) => {
        if (zoomScale === 1 || event.target !== lightboxImage) return;
        event.preventDefault();
        isDragging = true;
        dragStartX = event.clientX;
        dragStartY = event.clientY;
        dragStartPanX = panX;
        dragStartPanY = panY;
        lightboxStage.setPointerCapture(event.pointerId);
        lightboxImage.classList.add('portfolio-lightbox-is-dragging');
      });
      lightboxStage?.addEventListener('pointermove', (event) => {
        if (!isDragging) return;
        event.preventDefault();
        panX = dragStartPanX + event.clientX - dragStartX;
        panY = dragStartPanY + event.clientY - dragStartY;
        applyImageTransform();
      });
      const stopDragging = (event) => {
        if (!isDragging) return;
        isDragging = false;
        lightboxStage?.releasePointerCapture?.(event.pointerId);
        lightboxImage?.classList.remove('portfolio-lightbox-is-dragging');
      };
      lightboxStage?.addEventListener('pointerup', stopDragging);
      lightboxStage?.addEventListener('pointercancel', stopDragging);
      lightboxStage?.addEventListener('touchstart', (event) => {
        if (lightbox?.hidden || zoomScale > 1 || event.touches.length !== 1) return;
        touchStartX = event.touches[0].clientX;
        touchStartY = event.touches[0].clientY;
      }, { passive: true });
      lightboxStage?.addEventListener('touchend', (event) => {
        if (lightbox?.hidden || zoomScale > 1 || event.changedTouches.length !== 1) return;
        const touchEndX = event.changedTouches[0].clientX;
        const touchEndY = event.changedTouches[0].clientY;
        const deltaX = touchEndX - touchStartX;
        const deltaY = touchEndY - touchStartY;
        if (Math.abs(deltaX) < 50 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
        if (deltaX < 0) showNextImage();
        else showPreviousImage();
      }, { passive: true });
      document.addEventListener('keydown', (event) => {
        if (!lightbox || lightbox.hidden) return;
        if (event.key === 'Escape') closeLightbox();
        if (event.key === 'ArrowLeft') {
          showPreviousImage();
        }
        if (event.key === 'ArrowRight') {
          showNextImage();
        }
      });

      const loadFromGitHub = async () => {
        try {
          const res = await fetch(`https://api.github.com/repos/${owner}/${repo}/contents/public/${encodeURIComponent(folderName)}?ref=${encodeURIComponent(branch)}`);
          if (!res.ok) return;
          const data = await res.json();
          if (!Array.isArray(data)) return;
          const images = data
            .map((item) => item.name)
            .filter((name) => /\.(jpe?g|png|webp|gif|svg)$/i.test(name))
            .sort();
          if (images.length) renderImages(images);
        } catch (e) {
          // ignore and keep the build-time fallback
        }
      };

      markCurrentWorkVisited();
      loadFromGitHub();
    })();
  </script>
</section>

<style is:global>
  .portfolio-gallery-grid {
    column-count: 1;
    column-gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .portfolio-gallery-grid {
      column-count: 2;
    }
  }

  @media (min-width: 900px) {
    .portfolio-gallery-grid {
      column-count: 3;
    }
  }

  @media (min-width: 1400px) {
    .portfolio-gallery-grid {
      column-count: 4;
    }
  }

  .portfolio-lightbox[hidden] {
    display: none;
  }

  .portfolio-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: stretch;
    justify-content: center;
    color: white;
  }

  .portfolio-lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(2 6 23 / 96%);
  }

  .portfolio-lightbox-panel {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, 96rem);
    flex-direction: column;
    justify-content: center;
    padding: 1rem;
  }

  .portfolio-lightbox-panel.portfolio-lightbox-centered {
    justify-content: center;
  }

  .portfolio-lightbox-centered .portfolio-lightbox-toolbar {
    position: absolute;
    top: 1rem;
    right: 1rem;
    left: 1rem;
  }

  .portfolio-lightbox-centered .portfolio-lightbox-stage {
    flex: 0 0 auto;
  }

  .portfolio-lightbox-centered .portfolio-lightbox-end {
    position: absolute;
    right: 1rem;
    left: 1rem;
    top: 50%;
    bottom: auto;
    z-index: 2;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 1.25rem;
    background: rgb(2 6 23 / 82%);
    padding: 1rem;
    backdrop-filter: blur(12px);
    transform: translateY(-50%);
  }

  .portfolio-lightbox-toolbar {
    position: absolute;
    top: 1rem;
    right: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .portfolio-lightbox-tools {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: center;
    margin: 0.25rem auto 0;
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 999px;
    background: rgb(15 23 42 / 78%);
    padding: 0.25rem;
    backdrop-filter: blur(8px);
  }

  .portfolio-lightbox-tools .portfolio-lightbox-button {
    position: relative;
    border-color: transparent;
    background: transparent;
  }

  .portfolio-lightbox-tools .portfolio-lightbox-button:not(:last-child)::after {
    position: absolute;
    top: 25%;
    right: -0.3rem;
    width: 1px;
    height: 50%;
    background: rgb(255 255 255 / 28%);
    content: '';
  }

  .portfolio-lightbox-tools .portfolio-lightbox-button:hover,
  .portfolio-lightbox-tools .portfolio-lightbox-button:focus-visible {
    border-color: rgb(255 255 255 / 25%);
    background: rgb(255 255 255 / 14%);
  }

  .portfolio-lightbox-tools .portfolio-lightbox-button svg {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
  }

  .portfolio-lightbox-count {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .portfolio-lightbox-stage {
    position: relative;
    display: flex;
    align-self: center;
    box-sizing: border-box;
    width: fit-content;
    max-width: 100%;
    min-height: 0;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 1rem;
    background: rgb(15 23 42 / 45%);
    touch-action: pan-y;
  }

  .portfolio-lightbox-stage.portfolio-lightbox-is-zoomed {
    touch-action: none;
    user-select: none;
  }

  .portfolio-lightbox-image {
    display: block;
    width: auto;
    height: auto;
    min-width: 0;
    max-height: calc(100vh - 8rem);
    max-width: calc(100vw - 2rem);
    object-fit: contain;
    border-radius: inherit;
    cursor: default;
    transform-origin: center center;
    transition: transform 180ms ease;
  }

  .portfolio-lightbox-is-zoomed .portfolio-lightbox-image {
    cursor: grab;
  }

  .portfolio-lightbox-is-zoomed .portfolio-lightbox-image.portfolio-lightbox-is-dragging {
    cursor: grabbing;
    transition: none;
  }

  .portfolio-lightbox-end[hidden] {
    display: none;
  }

  .portfolio-lightbox-end {
    position: absolute;
    top: 50%;
    right: 1rem;
    left: 1rem;
    z-index: 2;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 1.25rem;
    background: rgb(2 6 23 / 82%);
    padding: 1rem 0 0.5rem;
    text-align: center;
