---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chess Set | DigitalWoodworker</title>
    <meta name="description" content="Chess sets by DigitalWoodworker." />
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">Chess Set</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Chess Set</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">Placeholder page for custom chess sets and game boards.</p>
      </section>
    </main>
    <Footer />
  </body>
</html>
