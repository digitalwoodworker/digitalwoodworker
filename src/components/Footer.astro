<footer id="contact" class="bg-slate-950 text-slate-100">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div>
        <p class="text-sm uppercase tracking-[0.4em] text-amber-400">Get in touch</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl">I can help you turn your ideas into reality.</h2>
        <p class="mt-6 max-w-xl text-sm leading-7 text-slate-300">
          Email me with your ideas, and I’ll respond with a thoughtful consultation to bring your vision to life.
        </p>
      </div>

      <div class="grid gap-8">
        <div>
          <p class="text-sm uppercase tracking-[0.4em] text-slate-400">Contact</p>
          <p class="mt-4 text-base text-slate-100">digitalwoodworker@gmail.com</p>
         
        </div>
        <div>
          <p class="text-sm uppercase tracking-[0.4em] text-slate-400">Location</p>
          <p class="mt-4 text-base text-slate-100">Trivandrum, Kerala, India</p>
         
        </div>
      </div>
     
    </div>

