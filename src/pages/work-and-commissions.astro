---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fs from 'fs';
import path from 'path';

const publicDir = path.join(process.cwd(), 'public');
const basePath = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL;
const withBase = (href: string) => {
  const normalizedHref = href === '/' ? '/' : `${href.replace(/\/+$/, '')}/`;
  return basePath === '/' ? normalizedHref : `${basePath.replace(/\/+$/, '')}${normalizedHref}`;
};
const canonicalUrl = new URL('/work-and-commissions/', Astro.site).toString();
const cardFolders: Record<string, string> = {
  'scale-models': 'Scale-Models',
  'wood-turning': 'Wood-Turning',
  boxes: 'Boxes',
  'chess-set': 'Chess-Set',
  intarsia: 'Intarsia',
  clocks: 'Clocks',
};

function randomCardImage(folder: string) {
  const folderPath = path.join(publicDir, folder);
  if (!fs.existsSync(folderPath)) return null;
  const files = fs.readdirSync(folderPath).filter((file: string) => /\.(jpe?g|png|webp|gif|svg)$/i.test(file));
  if (!files.length) return null;
  return `${basePath}${encodeURIComponent(folder)}/${encodeURIComponent(files[Math.floor(Math.random() * files.length)])}`;
}

const cards = [
  { href: '/scale-models', title: 'Scale Models', description: 'Big stories, captured in tiny timber.' },
  { href: '/wood-turning', title: 'Wood Turning', description: 'Form carved in motion—bringing out the natural beauty within.' },
  { href: '/boxes', title: 'Boxes', description: 'Small spaces, timeless craftsmanship' },
  { href: '/chess-set', title: 'Chess Set', description: 'Timeless battles, played out on handcrafted grain.' },
  { href: '/intarsia', title: 'Intarsia', description: 'Painting with natural wood grains, one piece at a time.' },
  { href: '/clocks', title: 'Clocks', description: 'Marking time through the timeless beauty of natural wood.' },
].map((card) => ({
  ...card,
  resolvedHref: withBase(card.href),
  image: randomCardImage(cardFolders[card.href.slice(1)]),
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Custom Woodworking & Commissions | DigitalWoodworker</title>
    <meta name="description" content="Explore custom woodworking commissions from DigitalWoodworker, including handcrafted scale models, wood turning, clocks, boxes, intarsia, and bespoke furniture." />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="custom woodworking, commissions, handcrafted woodwork, scale models, wood turning, bespoke furniture" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Custom Woodworking & Commissions | DigitalWoodworker" />
    <meta property="og:description" content="Explore custom woodworking commissions from DigitalWoodworker, including handcrafted scale models, wood turning, clocks, boxes, intarsia, and bespoke furniture." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="DigitalWoodworker" />
    <meta property="og:image" content={withBase('/dw_logo.png')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Custom Woodworking & Commissions | DigitalWoodworker" />
    <meta name="twitter:description" content="Explore custom woodworking commissions from DigitalWoodworker, including handcrafted scale models, wood turning, clocks, boxes, intarsia, and bespoke furniture." />
    <meta name="twitter:image" content={withBase('/dw_logo.png')} />
    <!-- TODO: Update the title and description copy here when you want to refine the SEO wording for this page. -->
    <link rel="icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <link rel="shortcut icon" type="image/x-icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <script data-goatcounter="https://digitalwoodworker.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="mb-16 text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">Work & Commissions</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Every piece has a story.</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">
          Woodworking is about honoring the material and bringing ideas to life. Step through my portfolio to discover recent work, custom builds, and the stories behind them.
        </p>
      </section>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {cards.map((card) => (
          <a href={card.resolvedHref} class="group overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-50 transition hover:border-slate-300 hover:bg-white">
            {card.image ? (
              <div class="flex h-52 items-center justify-center bg-slate-100 p-3 sm:h-56 md:h-60 lg:h-64">
                <img
                  class="h-full w-full object-contain object-center transition duration-300 group-hover:scale-[1.02]"
                  src={card.image}
                  alt={`${card.title} preview`}
                />
              </div>
            ) : null}
            <div class="p-8 text-center">
              <h2 class="text-xl font-semibold text-slate-950">{card.title}</h2>
              <p class="mt-3 text-sm leading-7 text-slate-600">{card.description}</p>
            </div>
          </a>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
