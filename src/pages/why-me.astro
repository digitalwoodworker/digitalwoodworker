---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Why Me | DigitalWoodworker</title>
    <meta name="description" content="Why DigitalWoodworker is the right choice for your custom woodworking project." />
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="mb-12 text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">Why Me</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Why choose DigitalWoodworker?</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">
          Explore the values, quality standards, and customer focus that make custom woodworking projects stand out.
        </p>
      </section>

      <section class="grid gap-8 lg:grid-cols-3">
        <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-8">
          <h2 class="text-xl font-semibold text-slate-950">Trusted Quality</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">A strong focus on durability, fit, and finish for every build.</p>
        </div>
        <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-8">
          <h2 class="text-xl font-semibold text-slate-950">Custom Collaboration</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">Clear communication and a tailored process from concept to completion.</p>
        </div>
        <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-8">
          <h2 class="text-xl font-semibold text-slate-950">Attention to Detail</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">Every curve, cut, and finish is chosen with the final result in mind.</p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
