---
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const projects = [
  { title: 'Wright Brothers aircraft', subtitle: 'A 1:28 scale model of the 1903 Wright brothers aircraft in wood', image: `${basePath}/Scale-Models/Wright.jpg` },
  { title: 'Miro inspired Custom Chess Set', subtitle: 'Co-created with <a href="https://www.nihalaarons.com/" class="underline">Nihal Aarons</a> based on the original design by Nihal.', image: `${basePath}/Chess-Set/Chessset.jpg`  },
  { title: '1855 The General Steam Engine', subtitle: 'A extremely detailed scale model of \'The General\' steam engine', image: `${basePath}/Scale-Models/Train.jpg` },
];
---

<section id="portfolio" class="py-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.4em] text-amber-500">Featured portfolio highlights</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Beautiful pieces made to order.</h2>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {projects.map((project) => (
        <article class="group overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-950 shadow-lg shadow-slate-900/10">
          <div class="aspect-[4/3] bg-cover bg-center transition duration-500 group-hover:scale-105" style={`background-image:url(${project.image})`}></div>
          <div class="space-y-2 p-6">
            <h3 class="text-lg font-semibold text-white">{project.title}</h3>
            <p class="text-sm leading-7 text-slate-300" set:html={project.subtitle}></p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
