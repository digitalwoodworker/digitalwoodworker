---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work & Commissions | DigitalWoodworker</title>
    <meta name="description" content="Work and commissions from DigitalWoodworker." />
  </head>
  <body class="bg-white text-slate-900">
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-20">
      <section class="mb-16 text-center">
        <p class="text-sm uppercase tracking-[0.4em] text-amber-500">Work & Commissions</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Crafted commissions and custom furniture work.</h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-600">
          Explore our current project categories with placeholder pages for each service. Replace this copy when the studio content is ready.
        </p>
      </section>

      <div class="grid gap-8 md:grid-cols-3">
        <a href="/work-and-commissions#custom-tables" class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-8 text-center transition hover:border-slate-300 hover:bg-white">
          <h2 class="text-xl font-semibold text-slate-950">Custom Tables</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">Placeholder for custom dining and occasional tables.</p>
        </a>
        <a href="/work-and-commissions#built-in-projects" class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-8 text-center transition hover:border-slate-300 hover:bg-white">
          <h2 class="text-xl font-semibold text-slate-950">Built-in Projects</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">Placeholder for shelving, cabinetry, and bespoke installations.</p>
        </a>
        <a href="/work-and-commissions#commission-process" class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-8 text-center transition hover:border-slate-300 hover:bg-white">
          <h2 class="text-xl font-semibold text-slate-950">Commission Process</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">Placeholder for how commissions are planned and delivered.</p>
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>
